# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/

# ─── Secrets — never commit these ─────────────────────────────────────────────
# Environment files (wallet mnemonic / seed, private-state password)
.env
.env.local
.env.*.local

# Generated wallet credentials and the deployment record
.midnight-state.json

# Cached wallet sync state (per-network)
.midnight-wallet-state/

# Local sealed-bid openings (amount + nonce; the nonce must stay private)
.sealedbid-openings.json

# Encrypted private-state databases produced by the level private-state provider
*-state/
midnight-level-db/

# Logs and coverage
logs/
*.log
coverage/

# Editors / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp

# NOTE: contracts/managed/ is intentionally NOT ignored.
# The Compact compiler output (TypeScript bindings, circuit IR and proving
# keys) is committed so that the project can be built, tested and replayed
# without the Compact toolchain installed. Regenerate it with `npm run compile`;
# verify it is current with `npm run verify:artifacts`.
